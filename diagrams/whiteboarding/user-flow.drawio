        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-260" value="Planning brings together all your tasks and events from all workspaces and personal calendar.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In this section you can view all your tasks and events in a list and you can start putting them on calendar.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;You can also view other calendars that you are part of (shared private calendars or public calendars) and also the tasks and events that have been shared with you.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="2460" y="145.12" width="370" height="274.88" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-261" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;glass=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="3222" y="200.56" width="150" height="89.44" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-262" value="&lt;font style=&quot;font-size: 10px; line-height: 60%;&quot;&gt;Event that has been shared&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=12;fontColor=light-dark(#d89c05, #ededed);" vertex="1" parent="1">
          <mxGeometry x="3222" y="289.93" width="140" height="19.44" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-263" value="&lt;font style=&quot;font-size: 10px; line-height: 60%;&quot;&gt;Drafted Reminder&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=12;fontColor=light-dark(#ba5753, #ededed);" vertex="1" parent="1">
          <mxGeometry x="3222" y="364.43" width="140" height="19.44" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-264" value="&lt;font style=&quot;font-size: 10px; line-height: 60%;&quot;&gt;Drafted Task&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=12;fontColor=light-dark(#6e90c1, #ededed);" vertex="1" parent="1">
          <mxGeometry x="3062" y="260" width="140" height="19.44" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-265" value="Accounting" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1065" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-267" value="You can define rate or a fixed amount for tasks or events and Qwest can calculate your income and expenses." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1100" width="516" height="60" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-269" value="QQL (Qwest Query Language)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1225" width="458" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-270" value="QQL can help you query your own data and gather everything you need. Like how much time you have spent on a specific task or what friends have halped you with tasks of a specific tag and so on.&amp;nbsp;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1260" width="516" height="130" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-271" value="qwest version 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6a00ff;strokeColor=#3700CC;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="2462" y="1200" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-272" value="qwest version 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="2462" y="1040" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-273" value="Journaling" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="50" y="1595" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-274" value="Each day can have an entry for journaling and AI can help you along the way to get quickly done with summing up the day." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="50" y="1625" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-275" value="&lt;font style=&quot;font-size: 56px;&quot;&gt;Misc&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="2460" y="930" width="461" height="70" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-276" value="Templates and Bulk Update" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="580" y="1595" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-277" value="To save time, you can define templates and initiate bulk updates like removing tasks for an entire week and so on." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="580" y="1625" width="440" height="85" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-278" value="Integrating with Other Calendar Services" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="3021" y="1065" width="469" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-279" value="Import other calendars into Qwest. This might come with a set of restrictions because Qwest is providing features that are not standard and this could cause problems." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="3021" y="1100" width="516" height="80" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-280" value="qwest version 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="3023" y="1040" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-281" value="AI Assistant Chatbot" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="3023" y="1225" width="469" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-282" value="This chatbot can help users to do their things faster, like defining tasks and events based upon a week ago or get users QQLs to get statistics." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="3023" y="1260" width="516" height="80" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-284" value="qwest version 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6a00ff;strokeColor=#3700CC;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="3023" y="1200" width="100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="GNYwGQDYNVE5GSD1HZfe-209" value="Communities" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1375" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-211" value="qwest version 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1350" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-212" value="The simple idea is that users can create channels that they can post taks or events and other users can subscribe to these communities to get in touch with mind alike people and increase their productivity in the times of burnout." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1410" width="516" height="110" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-213" value="Social Media" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1595" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-214" value="qwest version 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6a00ff;strokeColor=#3700CC;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1570" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-215" value="The idea is that users can post about their work, task, getting things done, and so on. Would require chatting capabilities and news feed. Might end up a place like LinkedIn, so we should think of ways to keep this concise and healthy." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1630" width="516" height="110" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-216" value="Sharing Policy: Who owns the data?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="1810" y="1375" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-217" value="In sharing scenarios, this question often gets asked that who owns the data?&lt;div&gt;For example, User has shared a task with Judy, and Judy can see that task in her calendar as well. What happens if user deletes that task after a while or removes Judy from their friends list? Would Judy lose that task or event&#39;s data as well?&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Well the answer is if the task or event&#39;s time has passed, no she should not lose that data because that is part of her past. She shouldn&#39;t return to a year ago and see a blank slot and wonder what was she doing at that time.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1810" y="1410" width="516" height="250" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-218" value="qwest version 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1810" y="595" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-219" value="Private Calendar Share" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="1202" y="150" width="461" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-220" value="qwest version 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="52" y="1260" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-221" value="&lt;font style=&quot;font-size: 56px;&quot;&gt;Planning&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="2460" y="50" width="461" height="70" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-222" value="You can define tasks and events that don&#39;t have any time boundary on them. This will help you with defining all the future tasks without worrying about where to put them on the calendar." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="2460" y="611.49" width="516" height="94.88" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-223" value="Defining tasks and events for the future" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="2460" y="582.56" width="461" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-224" value="Drafting tasks and events" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="2460" y="757.86" width="461" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-225" value="Even after you have put a time boundary on a task, you can draft it. This will cause it not to publish on your calendar so you can decide about it later." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="2460" y="783.9300000000001" width="516" height="94.88" as="geometry" />
        </mxCell>

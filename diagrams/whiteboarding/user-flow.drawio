        <mxCell id="GNYwGQDYNVE5GSD1HZfe-228" value="AI to the rescue" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">

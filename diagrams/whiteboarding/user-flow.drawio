          <mxGeometry x="1810" y="626.75" width="461" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-163" value="Users can create calendars other than their own private calendars. These calendars are public and shareable. The use case would be having a calendar that has &lt;b&gt;national events of Iran &lt;/b&gt;and other users could add this calendar to their own calendar to see the events.&lt;span style=&quot;color: rgba(0, 0, 0, 0); font-family: monospace; font-size: 0px; text-wrap: nowrap;&quot;&gt;%3CmxGraphModel%3E%3Croot%3E%3CmxCell%20id%3D%220%22%2F%3E%3CmxCell%20id%3D%221%22%20parent%3D%220%22%2F%3E%3CmxCell%20id%3D%222%22%20value%3D%22Friends%22%20style%3D%22text%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dmiddle%3BwhiteSpace%3Dwrap%3Brounded%3D0%3BfontStyle%3D1%3BfontSize%3D24%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%221200%22%20y%3D%22626.75%22%20width%3D%22461%22%20height%3D%2230%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3CmxCell%20id%3D%223%22%20value%3D%22In%20Qwest%20you%20have%20a%20username%20and%20a%20user%20profile.%20Other%20people%20can%20find%20you%20and%20send%20friend%20requests%20to%20you.%20You%20can%20accept%20their%20request%20and%20become%20friends%20or%20just%20reject%20them%20and%20remove%20their%20request.%26lt%3Bdiv%26gt%3B%26lt%3Bbr%26gt%3B%26lt%3B%2Fdiv%26gt%3B%26lt%3Bdiv%26gt%3BThe%20reason%20we%20have%20chosen%20friend%20request%20system%20instead%20of%20follower%2Ffollowee%20system%20is%20that%20we%20want%20to%20keep%20this%20system%20focused%20on%20increasing%20the%20productivity.%26lt%3B%2Fdiv%26gt%3B%22%20style%3D%22text%3Bhtml%3D1%3Balign%3Dleft%3BverticalAlign%3Dtop%3BwhiteSpace%3Dwrap%3Brounded%3D0%3BfontStyle%3D0%3BfontSize%3D18%3B%22%20vertex%3D%221%22%20parent%3D%221%22%3E%3CmxGeometry%20x%3D%221200%22%20y%3D%22665.12%22%20width%3D%22516%22%20height%3D%22194.88%22%20as%3D%22geometry%22%2F%3E%3C%2FmxCell%3E%3C%2Froot%3E%3C%2FmxGraphModel%3E&lt;b&gt;a&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1810" y="665.12" width="516" height="124.88" as="geometry" />
        </mxCell>

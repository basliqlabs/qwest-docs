        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-230" value="AI can help you plan with all your tasks that you have in your backlog. It will try to give you the most productive plan based on task priorities, durations, the free time that you have, and your performance history." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">

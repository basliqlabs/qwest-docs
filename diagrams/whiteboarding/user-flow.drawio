        <mxCell id="GNYwGQDYNVE5GSD1HZfe-151" value="From: 2025-01-01&lt;div&gt;To: 2026-06-15&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1460" y="269" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-152" value="In the example below, Judy can see all tasks and events that have been created by or shared with User.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;There are a few exceptions though:&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1- Hidden tasks or events are hidden and Judy can&#39;t see them&lt;/b&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2- Tasks that have been created in a workspace and assigned to a user will not have all the information to Judy&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Shares could have time limitations, You can share a time slice of your calendar with the person. E.g. You can share a month&#39;s worth of tasks and events with a person and they won&#39;t be able to see before or after.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1940" y="171.37" width="406" height="358.63" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-153" value="Friends" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="1200" y="626.75" width="461" height="30" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-154" value="In Qwest you have a username and a user profile. Other people can find you and send friend requests to you. You can accept their request and become friends or just reject them and remove their request.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The reason we have chosen friend request system instead of follower/followee system is that we want to keep this system focused on increasing the productivity.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontStyle=0;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1200" y="665.12" width="516" height="194.88" as="geometry" />
        </mxCell>
        <mxCell id="GNYwGQDYNVE5GSD1HZfe-158" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1.01;entryY=0.656;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="GNYwGQDYNVE5GSD1HZfe-141" target="GNYwGQDYNVE5GSD1HZfe-119">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
